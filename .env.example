# Copia este archivo a .env y ajusta los valores. No subas .env al repositorio.

# PostgreSQL (SQLAlchemy + psycopg 3)
DATABASE_URL=postgresql+psycopg://qa:qa@localhost:5432/qa_acreditacion

# Directorio persistente donde se guardan los PDF originales
STORAGE_DIR=data/pdfs
MAX_PDF_MB=50

# Qdrant. Si QDRANT_URL está definido se usa ese servidor (local o Cloud).
# Si no, se usa el modo embebido en disco (QDRANT_PATH). Con ambos vacíos, en memoria.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION=acreditacion_chunks

# OpenRouter
OPENROUTER_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-5
EMBEDDING_MODEL=openai/text-embedding-3-large
# Debe coincidir con el modelo de embeddings (3072 para text-embedding-3-large)
EMBEDDING_DIMENSION=3072
TOP_K=5
